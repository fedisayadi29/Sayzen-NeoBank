{
  "name": "sayzen-bank",
  "version": "1.0.0",
  "description": "Sayzen Bank - NEOBank Digitale Tunisienne",
  "private": true,
  "keywords": [
    "neobank",
    "banking",
    "fintech",
    "tunisian",
    "react",
    "nodejs"
  ],
  "author": "Sayzen Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev:backend",
    "build": "cd frontend && npm run build",
    "seed:all": "cd backend && npm run seed:all",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "format": "cd backend && npm run format && cd ../frontend && npm run format",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
